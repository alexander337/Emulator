<Page x:Class="SroNexusApp.Views.DatabaseConnectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="Database Connection">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="SQL Server Connection" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <GroupBox Header="Connection Settings" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Server:"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Name="txtServer" Text="localhost" Margin="5"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Database:"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Name="txtDatabase" Text="SRO_VT_SHARD" Margin="5"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="Authentication:"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" Name="cmbAuth" Margin="5" SelectedIndex="0">
                        <ComboBoxItem>SQL Server Authentication</ComboBoxItem>
                        <ComboBoxItem>Windows Authentication</ComboBoxItem>
                    </ComboBox>

                    <Label Grid.Row="3" Grid.Column="0" Content="Username:" Name="lblUsername"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Name="txtUsername" Margin="5"/>

                    <Label Grid.Row="4" Grid.Column="0" Content="Password:" Name="lblPassword"/>
                    <PasswordBox Grid.Row="4" Grid.Column="1" Name="txtPassword" Margin="5"/>

                    <CheckBox Grid.Row="5" Grid.Column="1" Name="chkTrustCert" Content="Trust Server Certificate" IsChecked="True" Margin="5"/>

                    <Label Grid.Row="6" Grid.Column="0" Content="Connection String:"/>
                    <TextBox Grid.Row="6" Grid.Column="1" Name="txtConnectionString" IsReadOnly="True" 
                             TextWrapping="Wrap" Margin="5" Background="#F0F0F0"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="Database Status" Padding="10" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Name="txtStatus" Text="Not connected" FontWeight="Bold" Foreground="Red"/>
                    <ProgressBar Name="progressBar" Height="20" Margin="0,10,0,0" Visibility="Collapsed"/>
                    <TextBlock Name="txtProgress" Text="" Margin="0,5,0,0"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="btnTestConnection" Content="Test Connection" Width="120" Margin="5" Click="BtnTestConnection_Click"/>
            <Button Name="btnConnect" Content="Connect" Width="120" Margin="5" Click="BtnConnect_Click" IsEnabled="False"/>
            <Button Name="btnInitSchema" Content="Initialize Schema" Width="120" Margin="5" Click="BtnInitSchema_Click" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Page>
