<Page x:Class="SroNexus.Views.ItemsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:local="clr-namespace:SroNexus.Views"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1400"
      Title="Items Manager">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <materialDesign:Card Grid.Row="0" Margin="10" Padding="10">
            <StackPanel>
                <TextBlock Text="ITEMS MANAGER" Style="{StaticResource MaterialDesignHeadline5TextBlock}" Margin="0,0,0,10"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Search and Filter -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBox x:Name="SearchBox" 
                                 materialDesign:HintAssist.Hint="Search items..."
                                 Width="300" Margin="0,0,10,0"
                                 TextChanged="SearchBox_TextChanged"/>
                        
                        <ComboBox x:Name="TypeFilter" 
                                  materialDesign:HintAssist.Hint="Item Type"
                                  Width="150" Margin="0,0,10,0"
                                  SelectionChanged="TypeFilter_SelectionChanged">
                            <ComboBoxItem Content="All Types"/>
                            <ComboBoxItem Content="Weapon"/>
                            <ComboBoxItem Content="Armor"/>
                            <ComboBoxItem Content="Accessory"/>
                            <ComboBoxItem Content="Consumable"/>
                            <ComboBoxItem Content="Quest"/>
                        </ComboBox>
                        
                        <TextBox x:Name="LevelMinFilter" 
                                 materialDesign:HintAssist.Hint="Min Level"
                                 Width="80" Margin="0,0,5,0"/>
                        
                        <TextBox x:Name="LevelMaxFilter" 
                                 materialDesign:HintAssist.Hint="Max Level"
                                 Width="80" Margin="0,0,10,0"/>
                        
                        <Button Content="FILTER" Click="FilterButton_Click"/>
                    </StackPanel>
                    
                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="CREATE NEW" 
                                Style="{StaticResource MaterialDesignRaisedAccentButton}"
                                Margin="5,0" Click="CreateNew_Click"/>
                        <Button Content="DUPLICATE" 
                                Margin="5,0" Click="Duplicate_Click"/>
                        <Button Content="BULK EDIT" 
                                Margin="5,0" Click="BulkEdit_Click"/>
                        <Button Content="IMPORT" 
                                Margin="5,0" Click="Import_Click"/>
                        <Button Content="EXPORT" 
                                Margin="5,0" Click="Export_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </materialDesign:Card>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Items List -->
            <materialDesign:Card Grid.Column="0" Margin="10,0,5,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Items List" 
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                               Margin="10"/>
                    
                    <DataGrid Grid.Row="1" x:Name="ItemsDataGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              SelectionChanged="ItemsDataGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="150"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding ItemTypeDisplay}" Width="80"/>
                            <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="50"/>
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="50"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    
                    <TextBlock Grid.Row="2" x:Name="ItemCountText" 
                               Text="Total: 0 items" 
                               Margin="10"
                               HorizontalAlignment="Right"/>
                </Grid>
            </materialDesign:Card>

            <!-- Item Editor -->
            <materialDesign:Card Grid.Column="1" Margin="5,0,10,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="ITEM EDITOR" 
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                   Margin="0,0,0,20"/>
                        
                        <!-- Basic Information -->
                        <Expander Header="Basic Information" IsExpanded="True">
                            <Grid Margin="0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBox Grid.Row="0" Grid.Column="0" x:Name="ItemNameBox"
                                         materialDesign:HintAssist.Hint="Item Name"
                                         Margin="5"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="ItemCodeBox"
                                         materialDesign:HintAssist.Hint="Item Code"
                                         Margin="5"/>
                                
                                <TextBox Grid.Row="1" Grid.Column="0" x:Name="DisplayNameBox"
                                         materialDesign:HintAssist.Hint="Display Name"
                                         Margin="5"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="LevelBox"
                                         materialDesign:HintAssist.Hint="Level Required"
                                         Margin="5"/>
                                
                                <ComboBox Grid.Row="2" Grid.Column="0" x:Name="ItemTypeBox"
                                          materialDesign:HintAssist.Hint="Item Type"
                                          Margin="5">
                                    <ComboBoxItem Content="Weapon"/>
                                    <ComboBoxItem Content="Armor"/>
                                    <ComboBoxItem Content="Accessory"/>
                                    <ComboBoxItem Content="Consumable"/>
                                    <ComboBoxItem Content="Quest"/>
                                    <ComboBoxItem Content="Other"/>
                                </ComboBox>
                                
                                <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" 
                                         x:Name="DescriptionBox"
                                         materialDesign:HintAssist.Hint="Description"
                                         TextWrapping="Wrap"
                                         Height="60"
                                         Margin="5"/>
                            </Grid>
                        </Expander>
                        
                        <!-- Combat Statistics -->
                        <Expander Header="Combat Statistics" Margin="0,10">
                            <Grid Margin="0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="5">
                                    <TextBox x:Name="PhysicalAttackMinBox"
                                             materialDesign:HintAssist.Hint="Phys ATK Min"
                                             Width="100" Margin="0,0,5,0"/>
                                    <TextBlock Text="-" VerticalAlignment="Center" Margin="5,0"/>
                                    <TextBox x:Name="PhysicalAttackMaxBox"
                                             materialDesign:HintAssist.Hint="Phys ATK Max"
                                             Width="100"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="5">
                                    <TextBox x:Name="MagicalAttackMinBox"
                                             materialDesign:HintAssist.Hint="Mag ATK Min"
                                             Width="100" Margin="0,0,5,0"/>
                                    <TextBlock Text="-" VerticalAlignment="Center" Margin="5,0"/>
                                    <TextBox x:Name="MagicalAttackMaxBox"
                                             materialDesign:HintAssist.Hint="Mag ATK Max"
                                             Width="100"/>
                                </StackPanel>
                                
                                <TextBox Grid.Row="1" Grid.Column="0" x:Name="PhysicalDefenseBox"
                                         materialDesign:HintAssist.Hint="Physical Defense"
                                         Margin="5"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="MagicalDefenseBox"
                                         materialDesign:HintAssist.Hint="Magical Defense"
                                         Margin="5"/>
                                
                                <TextBox Grid.Row="2" Grid.Column="0" x:Name="HitRateBox"
                                         materialDesign:HintAssist.Hint="Hit Rate %"
                                         Margin="5"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="ParryRateBox"
                                         materialDesign:HintAssist.Hint="Parry Rate %"
                                         Margin="5"/>
                                
                                <TextBox Grid.Row="3" Grid.Column="0" x:Name="CriticalRateBox"
                                         materialDesign:HintAssist.Hint="Critical Rate %"
                                         Margin="5"/>
                            </Grid>
                        </Expander>
                        
                        <!-- Alchemy Options -->
                        <Expander Header="Alchemy Options" Margin="0,10">
                            <StackPanel Margin="0,10">
                                <CheckBox x:Name="AlchemyEnabledCheck" Content="Enable Alchemy System" Margin="5"/>
                                
                                <DataGrid x:Name="AlchemyOptionsGrid"
                                          Height="200"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="True"
                                          Margin="5">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="60"/>
                                        <DataGridTextColumn Header="Option" Binding="{Binding Name}" Width="100"/>
                                        <DataGridTextColumn Header="Min" Binding="{Binding MinValue}" Width="60"/>
                                        <DataGridTextColumn Header="Max" Binding="{Binding MaxValue}" Width="60"/>
                                        <DataGridTextColumn Header="Success %" Binding="{Binding SuccessRate}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Expander>
                        
                        <!-- Plus System -->
                        <Expander Header="Plus Enhancement System" Margin="0,10">
                            <Grid Margin="0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                          x:Name="PlusEnabledCheck" 
                                          Content="Enable Plus System" 
                                          Margin="5"/>
                                
                                <TextBox Grid.Row="1" Grid.Column="0" x:Name="MaxPlusLevelBox"
                                         materialDesign:HintAssist.Hint="Max Plus Level"
                                         Margin="5"/>
                                
                                <CheckBox Grid.Row="1" Grid.Column="1" x:Name="DestroyOnFailCheck"
                                          Content="Destroy on Fail"
                                          Margin="5" VerticalAlignment="Center"/>
                                
                                <TextBox Grid.Row="2" Grid.Column="0" x:Name="SuccessRate1_7Box"
                                         materialDesign:HintAssist.Hint="+1 to +7 Success %"
                                         Margin="5"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="SuccessRate8_12Box"
                                         materialDesign:HintAssist.Hint="+8 to +12 Success %"
                                         Margin="5"/>
                                
                                <TextBox Grid.Row="3" Grid.Column="0" x:Name="SuccessRate13_15Box"
                                         materialDesign:HintAssist.Hint="+13 to +15 Success %"
                                         Margin="5"/>
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="SuccessRate16_20Box"
                                         materialDesign:HintAssist.Hint="+16 to +20 Success %"
                                         Margin="5"/>
                            </Grid>
                        </Expander>
                        
                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20">
                            <Button Content="SAVE" 
                                    Style="{StaticResource MaterialDesignRaisedAccentButton}"
                                    Width="100" Margin="5"
                                    Click="SaveItem_Click"/>
                            <Button Content="DELETE" 
                                    Style="{StaticResource MaterialDesignRaisedDarkButton}"
                                    Width="100" Margin="5"
                                    Click="DeleteItem_Click"/>
                            <Button Content="RESET" 
                                    Width="100" Margin="5"
                                    Click="ResetForm_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Page>
